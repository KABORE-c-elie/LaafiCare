<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 et moins : mêmes exclusions que data_extraction_rules.xml
  (aucune donnée sauvegardée : chiffrée par le Keystore, illisible après
  restauration). La doc exige ce second fichier même pour une application
  qui cible Android 12 ou plus : « you must also specify another set of XML
  backup rules to support devices that run Android 11 (API level 30) or
  lower ».
  Syntaxe : https://developer.android.com/identity/data/autobackup
  (« XML config syntax », Android 11 or lower).
-->
<full-backup-content>
    <exclude domain="root" path="./" />
    <exclude domain="file" path="./" />
    <exclude domain="database" path="./" />
    <exclude domain="sharedpref" path="./" />
    <exclude domain="external" path="./" />
    <exclude domain="device_root" path="./" />
    <exclude domain="device_file" path="./" />
    <exclude domain="device_database" path="./" />
    <exclude domain="device_sharedpref" path="./" />
</full-backup-content>
