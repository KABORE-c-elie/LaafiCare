        </mxCell>
        <mxCell id="s_inviter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="boundary" vertex="1" value="Inviter à un rôle&lt;br/&gt;(au numéro, valable 7 jours)">
