        </mxCell>
        <mxCell id="s_repondre" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="boundary" vertex="1" value="Accepter ou refuser une invitation&lt;br/&gt;(1re acceptation : crée le compte professionnel)">
