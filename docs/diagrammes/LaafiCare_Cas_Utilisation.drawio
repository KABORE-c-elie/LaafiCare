        </mxCell>
        <mxCell id="a_responsable" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" value="Responsable&lt;br/&gt;de structure">
