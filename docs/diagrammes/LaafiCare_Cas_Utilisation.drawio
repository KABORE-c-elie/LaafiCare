        </mxCell>
        <mxCell id="s_desactiver" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="boundary" vertex="1" value="Désactiver une affectation&lt;br/&gt;(jamais le dernier responsable)">
