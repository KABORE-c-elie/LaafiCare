        <mxCell id="u_totp_activer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="boundary" vertex="1" value="Activer le second facteur (TOTP),&lt;br/&gt;recevoir 10 codes de secours">
