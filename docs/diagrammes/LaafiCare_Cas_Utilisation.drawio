        <mxCell id="boundary" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#666666;fontSize=14;fontStyle=1;align=center;spacingTop=10;container=1;collapsible=0;" parent="1" vertex="1" value="Invitations et affectations (§14)">
          <mxGeometry x="330" y="50" width="560" height="520" as="geometry" />
        </mxCell>
        <mxCell id="s_annuler" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="boundary" vertex="1" value="Annuler une invitation&lt;br/&gt;en attente">
